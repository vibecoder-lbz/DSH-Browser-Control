{
  "name": "dsh-browser-use",
  "version": "0.5.1",
  "icon": "./chrome-extension/icons/icon128.png",
  "description": "DSH browser control: take over existing Chrome/Edge tabs in marked background copies, operate real logged-in sessions, edit structured configs and drive web terminals",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecoder-lbz/DSH-Browser-Control.git"
  },
  "homepage": "https://github.com/vibecoder-lbz/DSH-Browser-Control#readme",
  "bugs": {
    "url": "https://github.com/vibecoder-lbz/DSH-Browser-Control/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "browser-automation",
    "browser-control",
    "chrome-extension",
    "playwright",
    "computer-use",
    "web-terminal",
    "yaml"
  ],
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "chrome-extension/background.js",
    "chrome-extension/identity.js",
    "chrome-extension/manifest.json",
    "chrome-extension/options.html",
    "chrome-extension/page-marker.js",
    "chrome-extension/popup.html",
    "chrome-extension/shared.js",
    "chrome-extension/ui.css",
    "chrome-extension/ui.js",
    "chrome-extension/icons/icon16.png",
    "chrome-extension/icons/icon32.png",
    "chrome-extension/icons/icon48.png",
    "chrome-extension/icons/icon128.png",
    "chrome-extension/icons/README.md",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/browser.js && node --check src/cursor.js && node --check src/snapshot.js && node --check src/terminal.js && node --check src/url.js && node --check src/bridge.js && node --check src/editor.js && node --check src/yaml-edit.js && node --check src/format.js && node --check chrome-extension/background.js && node --check chrome-extension/page-marker.js && node --check chrome-extension/ui.js",
    "test": "node --test --test-concurrency=1 test/*.test.js chrome-extension/test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "pack:plugin": "npm pack --ignore-scripts"
  },
  "dependencies": {
    "playwright-core": "1.65.0",
    "ws": "8.21.0",
    "yaml": "2.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "ace-builds": "1.43.5",
    "codemirror": "5.65.20",
    "monaco-editor": "0.55.1"
  }
}
